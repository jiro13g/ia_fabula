# Copia este archivo como ".env" y rellena tus claves. NUNCA subas el .env a ningún sitio.
GEMINI_API_KEY=PEGA_AQUI_TU_CLAVE_DE_GOOGLE_AI_STUDIO
GEMINI_MODEL=gemini-3.8-flash
# Opcional: clave de Brave Search (https://brave.com/search/api/) para las fuentes web
SEARCH_API_KEY=
# Para "Generar imagen": clave gratis en https://enter.pollinations.ai (obligatoria)
POLLINATIONS_API_KEY=
IMAGE_MODEL=flux
FLASK_SECRET_KEY=cambia-esto-por-una-frase-larga-y-aleatoria
